{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@mindos/desktop#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-obsidian-desktop-runtime.mjs",
        "$TURBO_ROOT$/packages/web/lib/obsidian-compat/**",
        "$TURBO_ROOT$/packages/web/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": ["dist-electron/**"]
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
