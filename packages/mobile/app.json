{
  "expo": {
    "name": "MindOS",
    "slug": "human-ai-collaborative-mind-system",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1917"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geminilight.mindos",
      "infoPlist": {
        "NSCameraUsageDescription": "MindOS needs camera access to scan QR codes for connecting to your MindOS server.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "MindOS connects to the MindOS workspace running on your computer over your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1917"
      },
      "package": "com.geminilight.mindos",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "MindOS needs camera access to scan QR codes for connecting to your MindOS server.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-local-network.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "mindos",
    "extra": {
      "eas": {
        "projectId": "b24f8ff1-a88d-4501-884d-e15fe60855b0"
      }
    }
  }
}
